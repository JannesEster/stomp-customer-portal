{
  "floor": {
    "tileSizeMm": 500,
    "tilePx": 128
  },
  "screen": {
    "widthPx": 512,
    "heightPx": 1536,
    "maxScreens": 2,
    "slideSeconds": 5
  },
  "timings": [
    { "id": "start", "label": "Before the bridal entrance" },
    { "id": "middle", "label": "After the bridal entrance" },
    { "id": "end", "label": "Dancing time" }
