{
  "name": "stomp-customer-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "description": "Stomp Sphere customer portal. Booked customers plan what appears on their LED dance floor and portrait screens.",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "portal:tokens": "tsx scripts/portal-tokens.ts"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/gilda-display": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@fontsource/hurricane": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/monsieur-la-doulaise": "^5.3.0",
    "@fontsource/parisienne": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/prata": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "express": "^4.21.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
